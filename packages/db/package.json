{
  "name": "@dce/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support.d.ts",
      "default": "./dist/test-support.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import ../../scripts/load-root-env.mjs --import tsx src/migrate.ts",
    "setup:queue": "node --import ../../scripts/load-root-env.mjs --import tsx src/setup-queue.ts",
    "owner:bootstrap": "node --import ../../scripts/load-root-env.mjs --import tsx src/owner-bootstrap-cli.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/integration/*.test.ts",
    "verify:pgboss": "node --import tsx src/verify-pgboss-privileges.ts"
  },
  "dependencies": {
    "better-auth": "1.7.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "pg-boss": "12.30.0",
    "tsx": "4.20.5"
  }
}
