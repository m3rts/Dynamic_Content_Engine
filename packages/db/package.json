{
  "name": "@dce/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "node --import tsx src/migrate.ts",
    "test:integration": "node --import tsx --test src/integration/*.test.ts",
    "verify:pgboss": "node --import tsx src/verify-pgboss-privileges.ts"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "pg-boss": "12.30.0",
    "tsx": "4.20.5"
  }
}
