# Local development — copy to .env (never commit)
NODE_ENV=development

# Strict offline fixture mode is the default for foundation work.
DCE_FIXTURE_MODE=strict

# PostgreSQL (local Compose defaults)
DATABASE_URL=postgresql://dce_migrator:dce_migrator@127.0.0.1:5432/dce
MIGRATOR_DATABASE_URL=postgresql://dce_migrator:dce_migrator@127.0.0.1:5432/dce
ADMIN_DATABASE_URL=postgresql://dce:dce_local@127.0.0.1:5432/dce
TEST_DATABASE_URL=postgresql://dce:dce_local@127.0.0.1:5432/dce
AUTH_DATABASE_URL=postgresql://dce_auth:dce_auth@127.0.0.1:5432/dce
WEB_DATABASE_URL=postgresql://dce_web:dce_web@127.0.0.1:5432/dce

# Web/auth (generate BETTER_AUTH_SECRET with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000

# Worker/queue (local Compose defaults)
QUEUE_DATABASE_URL=postgresql://dce_queue:dce_queue@127.0.0.1:5432/dce
WORKER_DATABASE_URL=postgresql://dce_worker_app:dce_worker_app@127.0.0.1:5432/dce

# Local asset storage root (created on first use)
DCE_STORAGE_ROOT=.data/assets

# Provider keys belong in the worker environment only.
