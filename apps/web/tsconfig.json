{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@dce/i18n": ["../../packages/i18n/src/index.ts"],
      "@dce/ui": ["../../packages/ui/src/index.ts"],
      "@dce/policy": ["../../packages/policy/src/index.ts"],
      "@dce/contracts": ["../../packages/contracts/src/index.ts"],
      "@dce/db": ["../../packages/db/src/index.ts"],
      "@dce/db/test-support": ["../../packages/db/src/test-support.ts"],
      "@dce/storage": ["../../packages/storage/src/index.ts"]
    },
    "resolveJsonModule": true
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
