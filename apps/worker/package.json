{
  "name": "@dce/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ../../scripts/load-root-env.mjs --import tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integration": "node --import ../../scripts/load-root-env.mjs --import tsx --test --test-concurrency=1 src/integration/*.test.ts"
  },
  "dependencies": {
    "@dce/db": "workspace:*",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/pg": "8.15.5",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
